# --- Server ---
PORT=9090
# Bind address. Keep 127.0.0.1 when behind Cloudflare Tunnel (recommended);
# use 0.0.0.0 only if you intentionally expose the port directly.
HOST=127.0.0.1
# DATA_DIR defaults to ./data
# SECRET: set a long random string in production. If unset, one is generated and
# persisted to data/secret.key on first boot.
SECRET=change-me-to-a-long-random-string
TOKEN_TTL_HOURS=720

# --- Limits ---
MAX_UPLOAD_MB=25
MAX_PAYLOAD_KB=64
MEDIA_TTL_DAYS=30
CLEANUP_INTERVAL_MIN=60

# --- Email: Resend (recommended) ---
# Sign up at resend.com, create an API key (re_...), and add + verify a sending
# domain in the Resend dashboard (DNS records). A verified domain is required to
# email your friends; the shared onboarding@resend.dev sender only delivers to
# your own inbox.
RESEND_API_KEY=
# Sender for verification emails. Leave empty until you have added and verified a
# sending domain in the Resend dashboard (resend.com/domains). With an empty value
# the app falls back to onboarding@resend.dev, which only delivers to the email
# address on your Resend account - fine for first tests, not for friends.
# Example once verified: TextApp <noreply@aayanshah.me>
RESEND_FROM=

# --- Alternative: plain SMTP (any provider) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="TextApp <no-reply@example.com>"

# If neither Resend nor SMTP is configured, verification codes are written to
# data/dev-mails.log (console mailer) - handy for testing only.

# --- Firebase Cloud Messaging (HTTP v1). Optional; push is skipped when unset.
# Create a service account in the Firebase console, download its JSON, and use:
#   FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL,
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----\n"
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- TLS/domain ---
# Only used for links/headers; the app always talks to the public base URL you bake in.
PUBLIC_URL=https://your.domain.example
